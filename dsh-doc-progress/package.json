{
  "name": "dsh-doc-progress",
  "version": "0.1.0",
  "description": "在右侧栏 Markdown 预览中记住每个文件的阅读位置，切换会话或重新打开后自动回到上次读到的地方。",
  "author": "dsh-doc-progress contributors",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "scroll",
    "reading-progress"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
